{
  "name": "dsh-software-dev-office",
  "version": "0.1.0",
  "description": "基于软件工程方法论的 Agent 研发办公室：从可行性、需求审讯、架构设计到拆分派发、验证与交付（deepseek-harness 原生 Cordis 插件）",
  "type": "module",
  "license": "MIT",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/src",
    "presets",
    "skills",
    "src/data",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test lib/test/",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "software-engineering",
    "requirements",
    "architecture"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./presets/sdo-office.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "7.0.2"
  }
}
