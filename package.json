{
  "name": "sdo-v2",
  "version": "0.2.0",
  "private": true,
  "description": "SDO v2 · 真源与视图内核（M0 骨架）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test lib/test/",
    "spike:driver-native": "node test/spike/driver-native.mjs",
    "spike:node-sqlite": "node test/spike/node-sqlite-roundtrip.mjs",
    "console": "npm run build && node lib/src/ui/serve.js",
    "check": "npm run build && node lib/src/check/cli.js",
    "readings": "npm run build && node scripts/m0-readings.mjs",
    "readings:m1": "npm run build && node scripts/m1-readings.mjs",
    "signerd": "node scripts/signerd.mjs",
    "spike:crypto": "node scripts/spike/signerd-crypto.mjs",
    "spike:unix-socket": "node scripts/spike/unix-socket.mjs",
    "spike:test": "npm run build && node scripts/spike/copy-spike-tests.mjs && node --test lib/spike-test/",
    "readings:m2": "npm run build && node scripts/m2-readings.mjs",
    "readings:m3": "npm run build && node scripts/m3-readings.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "isomorphic-git": "^1.44.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
