{
  "name": "dsh-software-dev-office",
  "version": "0.1.4",
  "description": "基于软件工程方法论的 Agent 研发办公室：从可行性、需求审讯、架构设计到拆分派发、验证与交付（deepseek-harness 原生 Cordis 插件）",
  "type": "module",
  "license": "MIT",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/src",
    "presets",
    "skills",
    "src/data",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "clean": "rm -rf lib",
    "pack:offline": "node scripts/pack-offline.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "software-engineering",
    "requirements",
    "architecture"
  ],
  "dsh": {
    "bundle": {
      "patch": "./presets/sdo-office.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0-0 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-plan-mode": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <2.0.0-0 || ^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0-0 || ^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "7.0.2"
  },
  "author": "raitpor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raitpor/dsh-software-dev-office.git"
  },
  "homepage": "https://github.com/raitpor/dsh-software-dev-office#readme",
  "bugs": {
    "url": "https://github.com/raitpor/dsh-software-dev-office/issues"
  }
}
