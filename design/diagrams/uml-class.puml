@startuml
skinparam classAttributeIconSize 0
hide circle
class Intent {
  + id : IntentId
  + statement : string
  + strength : Strength
  + baseline : BaselineHash
  + approve(by)
  + reaffirm(baseline)
}
class GoalNode {
  + id : NodeId
  + parent : NodeId
  + scope : ScopePaths
  + acceptance : CriterionRef
  + declare()
  + acceptViaIntegration()
}
class Task {
  + id : TaskId
  + status : Status
  + lease : LeaseRef
  + block : BlockCode
  + claim(lease)
  + complete(evidence)
  + reopen(reason)
}
class WorkUnit {
  + id : WorkUnitId
  + criterion : CriterionId
  + spec : SpecId
  + evidence : EvidenceId
}
class Criterion {
  + id : CriterionId
  + remedy : Remedy
  + register()
}
class Fixture {
  + polarity : Polarity
  + input : string
  + expected : Verdict
}
class Gate {
  + id : GateId
  + policy : Policy
  + judge(readings) : Verdict
}
class StageRun {
  + id : StageRunId
  + baseline : BaselineHash
  + verdict : Verdict
}
class Snapshot {
  + id : SnapshotId
  + oid : GitOid
  + take(parents)
  + checkout(to)
}
class Decision {
  + id : DecisionId
  + payload : PayloadHash
  + frontier : Frontier
  + sign(signer)
}
class ReviewRound {
  + id : RoundId
  + verdict : Verdict
  + open()
  + close()
}
class Agent {
  + id : AgentId
  + state : State
  + watermark : number
}
class Spec {
  + id : SpecId
  + intent : IntentId
  + kind : Kind
  + contentHash : ContentHash
  + riskFlags : list
}
class Evidence {
  + id : EvidenceId
  + artifactSha256 : string
  + snapshot : SnapshotId
  + commit : string
}
class Lease {
  + id : LeaseId
  + agent : AgentId
  + task : TaskId
  + expiresAt : Timestamp
}
class WorkCopy {
  + id : WorkCopyId
  + task : TaskId
  + base : SnapshotId
}
class SnapshotParent {
  + snapshot : SnapshotId
  + parent : SnapshotId
}
class Release {
  + id : ReleaseId
  + inSet : Set
  + outSet : Set
  + freeze()
}
interface IntentRepository
interface EventStore {
  + append(event)
  + readTo(frontier)
}
interface SnapshotRepo
interface SignerPort {
  + sign(payload)
}
class ClockPort {
  + now()
}

Intent "1" ..> "1..*" Spec : 跨聚合
Spec "1" ..> "1..*" Criterion : 跨聚合
WorkUnit ..> Evidence
Task ..> Lease
Task ..> WorkCopy
Snapshot "1" --> "1..*" SnapshotParent
Intent "1" ..> "1" GoalNode : 根（跨聚合）
GoalNode --> GoalNode : 分解
GoalNode ..> Criterion : 叶验收（跨聚合）
Task "1" --> "1" WorkUnit
WorkUnit ..> Criterion : 跨聚合
Criterion "1" --> "1..*" Fixture
Gate ..> Criterion : 引用（跨聚合）
StageRun ..> Gate : 引用
Release ..> Snapshot : 交付绑快照（跨聚合）
Task ..> Agent : 认领者（跨聚合）
Intent ..> IntentRepository
Task ..> EventStore
Snapshot ..> SnapshotRepo
Decision ..> SignerPort
StageRun ..> ClockPort
@enduml
