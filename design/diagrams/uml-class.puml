@startuml
skinparam classAttributeIconSize 0
hide circle
class Intent {
  + id : IntentId
  + statement : string
  + sourceText : string
  + strength : Strength
  + approvedBy : ActorId
  + decisionId : DecisionId
  + contentHash : ContentHash
  + baseline : BaselineHash
  + approve(by)
  + reaffirm(baseline)
}
class GoalNode {
  + id : NodeId
  + parent : NodeId
  + intent : IntentId
  + goal : string
  + kind : Kind
  + scope : ScopePaths
  + acceptance : CriterionRef
  + decisionId : DecisionId
  + declare(decision)
  + acceptViaIntegration()
}
class Task {
  + id : TaskId
  + status : Status
  + lease : LeaseRef
  + block : BlockCode
  + inputs : InputRef[]
  + blockedBy : DependencyRef[]
  + setDependencies(deps)
  + claim(lease)
  + complete(evidence)
  + reopen(reason)
}
class WorkUnit {
  + id : WorkUnitId
  + criterion : CriterionId
  + spec : SpecId
  + evidence : EvidenceId
}
class Criterion {
  + id : CriterionId
  + remedy : Remedy
  + guarantee : Guarantee
  + appliesTo : list
  + register()
}
class Fixture {
  + polarity : Polarity
  + input : string
  + expected : Verdict
}
class Gate {
  + id : GateId
  + stage : StageId
  + criteria : list
  + policyMode : Mode
  + waivable : bool
  + judge(readings) : Verdict
}
class StageRun {
  + id : StageRunId
  + gateId : GateId
  + baseline : BaselineHash
  + criteria : list
  + verdict : Verdict
}
class Snapshot {
  + id : SnapshotId
  + oid : GitOid
  + take(parents)
  + checkout(to)
}
class Decision {
  + id : DecisionId
  + payload : PayloadHash
  + clauseReadings : list
  + frontier : Frontier
  + sign(signer)
}
class ReviewRound {
  + id : RoundId
  + taskId : TaskId
  + baselineHash : BaselineHash
  + frontier : Frontier
  + verdict : Verdict
  + signer : ActorId
  + open()
  + close()
}
class Agent {
  + id : AgentId
  + state : State
  + watermark : number
}
class Spec {
  + id : SpecId
  + intent : IntentId
  + kind : Kind
  + status : Status
  + blastRadius : string
  + isCore : bool
  + alternatives : list
  + noAlternativeReason : string
  + createdBy : ActorId
  + producer : ActorId
  + contentHash : ContentHash
  + riskFlags : list
}
class Evidence {
  + id : EvidenceId
  + artifactSha256 : string
  + snapshot : SnapshotId
  + commit : string
}
class Lease {
  + id : LeaseId
  + agent : AgentId
  + task : TaskId
  + expiresAt : Timestamp
}
class WorkCopy {
  + id : WorkCopyId
  + task : TaskId
  + base : SnapshotId
}
class SnapshotParent {
  + snapshot : SnapshotId
  + parent : SnapshotId
}
class Release {
  + id : ReleaseId
  + inSet : Set
  + outSet : Set
  + status : Status
  + baselineHash : BaselineHash
  + frontier : Frontier
  + frozenBy : list
  + freeze(baselineHash)
  + deliver(packageSha256, snapshotId)
  + rollback(newReleaseId)
}
class Baseline {
  + id : BaselineId
  + hash : BaselineHash
  + prev : BaselineId
  + direction : Direction
  + frozenBy : ActorId
  + content : BaselineContent
  + freeze(content, prev, direction) : BaselineId
  + validate(content) : ReasonCode[]
}
class BaselineContent {
  + policy : Policy
  + criteria : CriterionRef[]
  + gates : GateSpec[]
  + thresholds : Map
  + assurance : Assurance
  + engine : Engine
}
class CriterionRef {
  + id : CriterionId
  + version : number
  + params : Map
  + guarantee : Guarantee
}
class GateSpec {
  + id : GateId
  + stage : StageId
  + criteria : list
  + policyMode : Mode
  + waivable : bool
}
class Policy {
  + id : PolicyId
  + preset : string
  + stages : StageDef[]
  + gates : GateBinding
  + switches : Map
  + regression : Regression
  + artifactKinds : Map
}
class Restatement {
  + id : RestatementId
  + intent : IntentId
  + inputs : list
  + at : Timestamp
  + invalidate()
}
class Attention {
  + id : AttentionId
  + task : TaskId
  + askedOf : ActorId
  + question : string
  + options : list
  + state : State
  + expiresAt : Timestamp
  + answeredBy : ActorId
  + withdrawnBy : ActorId
  + supersedes : AttentionId
  + withdraw(by)
}
class Defect {
  + id : DefectId
  + criterion : CriterionId
  + spec : SpecId
  + task : TaskId
  + kind : Kind
  + severity : Severity
  + family : Family
  + status : Status
  + evidence : EvidenceId
  + record()
  + close(verifyRun)
}
interface IntentRepository
interface EventStore {
  + append(event)
  + readTo(frontier)
}
interface SnapshotRepo
interface SignerPort {
  + sign(payload)
}
class ClockPort {
  + now()
}

Intent "1" ..> "1..*" Spec : 跨聚合
Spec "1" ..> "1..*" Criterion : 跨聚合
WorkUnit ..> Evidence
Task ..> Lease
Task ..> WorkCopy
Snapshot "1" --> "1..*" SnapshotParent
Intent "1" --> "1..*" Restatement : 复述（聚合内）
Intent "1" ..> "1" GoalNode : 根（跨聚合）
GoalNode --> GoalNode : 分解
GoalNode ..> Criterion : 叶验收（跨聚合）
Task "1" --> "1" WorkUnit
Task "1" ..> "0..*" Defect : 判据红/集成回归
Defect ..> Criterion : 单位是判据
WorkUnit ..> Criterion : 跨聚合
Criterion "1" --> "1..*" Fixture
Gate ..> Criterion : 引用（跨聚合）
StageRun ..> Gate : 引用
Release ..> Snapshot : 交付绑快照（跨聚合）
Baseline "1" *-- "1" BaselineContent
BaselineContent "1" *-- "1" Policy
BaselineContent "1" *-- "1..*" CriterionRef
BaselineContent "1" *-- "1..*" GateSpec
Gate ..> GateSpec : 定义来自（跨聚合）
Intent ..> Baseline : 批准时依据（跨聚合）
StageRun ..> Baseline : 判定绑哪版尺子（跨聚合）
Release ..> Baseline : 本版按哪把尺子判（跨聚合）
Decision ..> Baseline : 冻结/放宽签字（跨聚合）
Task ..> Attention : 等人回答（跨聚合）
Task ..> Agent : 认领者（跨聚合）
Intent ..> IntentRepository
Task ..> EventStore
Snapshot ..> SnapshotRepo
Decision ..> SignerPort
StageRun ..> ClockPort
@enduml
